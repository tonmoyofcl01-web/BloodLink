NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

DATABASE_URL="mysql://bloodlink:change-me@localhost:3306/bloodlink"

SESSION_COOKIE_NAME=bloodlink_session
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=false

# Optional for local distributed-rate-limit testing.
# Without it, development uses memory.
# Production requires REDIS_URL and never falls back to memory.
# REDIS_URL=redis://localhost:6379

# Email verification via SMTP.
# Optional in local development; required in production.
# Configure all six values together.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=your-email@gmail.com

# Production requires a Redis-compatible URL for shared rate limiting.
# Local development uses memory by default.
# Set a local REDIS_URL only to test Redis-backed limits.
# REDIS_URL=rediss://username:password@redis.example.org:6379

# Vercel sets VERCEL=1 automatically.
# Do not set it manually outside Vercel.

# For production MySQL, require TLS certificate validation:
# DATABASE_URL="mysql://user:password@db.example.org:3306/bloodlink?sslaccept=strict"

# Set CLIENT_ORIGIN to the HTTPS origin of the deployed frontend.