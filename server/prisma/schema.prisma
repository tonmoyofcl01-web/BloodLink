generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETION_REQUESTED
  DELETED
}

enum DonorAvailabilityStatus {
  AVAILABLE
  PAUSED
}

enum BloodRequestUrgency {
  URGENT
  SCHEDULED
}

enum BloodRequestStatus {
  OPEN
  PAUSED
  CANCELLED
  CLOSED
}

model User {
  id               String                  @id @default(uuid()) @db.Char(36)
  email            String                  @unique @db.VarChar(254)
  passwordHash     String                  @map("password_hash") @db.VarChar(255)
  fullName         String                  @map("full_name") @db.VarChar(120)
  emailVerifiedAt  DateTime?               @map("email_verified_at") @db.DateTime(3)
  status           UserStatus              @default(PENDING_VERIFICATION)
  createdAt        DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt        DateTime?               @map("deleted_at") @db.DateTime(3)
  sessions         Session[]
  emailTokens      EmailVerificationToken[]
  adminAccount     AdminAccount?
  grantedAdmins   AdminAccount[]          @relation("AdminGrantor")
  donorProfile     DonorProfile?
  bloodRequests    BloodRequest[]

  @@index([status, createdAt])
  @@map("users")
}

model BloodGroup {
  id            Int            @id @default(autoincrement()) @db.UnsignedSmallInt
  code          String         @unique @db.VarChar(3)
  displayName   String         @map("display_name") @db.VarChar(30)
  donorProfiles DonorProfile[]
  bloodRequests BloodRequest[]

  @@map("blood_groups")
}

model DonorProfile {
  id                    String                  @id @default(uuid()) @db.Char(36)
  userId                String                  @unique @map("user_id") @db.Char(36)
  displayName           String                  @map("display_name") @db.VarChar(120)
  bloodGroupId          Int                     @map("blood_group_id") @db.UnsignedSmallInt
  division              String                  @db.VarChar(80)
  district              String                  @db.VarChar(80)
  area                  String                  @db.VarChar(100)
  availabilityStatus    DonorAvailabilityStatus @default(PAUSED) @map("availability_status")
  discoveryConsentAt    DateTime?               @map("discovery_consent_at") @db.DateTime(3)
  consentVersion        String?                 @map("consent_version") @db.VarChar(32)
  consentUpdatedAt      DateTime?               @map("consent_updated_at") @db.DateTime(3)
  createdAt             DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.DateTime(3)
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  bloodGroup            BloodGroup              @relation(fields: [bloodGroupId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([bloodGroupId, availabilityStatus, discoveryConsentAt], map: "donor_profiles_blood_group_avail_consent_idx")
  @@index([division, district, area])
  @@map("donor_profiles")
}

model BloodRequest {
  id               String              @id @default(uuid()) @db.Char(36)
  requesterUserId  String              @map("requester_user_id") @db.Char(36)
  bloodGroupId     Int                 @map("blood_group_id") @db.UnsignedSmallInt
  unitsRequested   Int                 @map("units_requested") @db.UnsignedSmallInt
  division         String              @db.VarChar(80)
  district         String              @db.VarChar(80)
  area             String              @db.VarChar(100)
  urgency          BloodRequestUrgency
  neededAt         DateTime            @map("needed_at") @db.DateTime(3)
  facilityName     String?             @map("facility_name") @db.VarChar(180)
  publicNote       String?             @map("public_note") @db.VarChar(500)
  status           BloodRequestStatus  @default(OPEN)
  closedAt         DateTime?           @map("closed_at") @db.DateTime(3)
  createdAt        DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.DateTime(3)
  requester        User                @relation(fields: [requesterUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  bloodGroup       BloodGroup          @relation(fields: [bloodGroupId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([requesterUserId, createdAt])
  @@index([status, neededAt, createdAt])
  @@index([bloodGroupId, division, district, area, status])
  @@map("blood_requests")
}

model Session {
  id         String    @id @default(uuid()) @db.Char(36)
  userId     String    @map("user_id") @db.Char(36)
  secretHash String    @unique @map("secret_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.DateTime(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  revokedAt  DateTime? @map("revoked_at") @db.DateTime(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  usedAt    DateTime? @map("used_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model AdminAccount {
  userId          String    @id @map("user_id") @db.Char(36)
  grantedByUserId String?   @map("granted_by_user_id") @db.Char(36)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  revokedAt       DateTime? @map("revoked_at") @db.DateTime(3)
  user            User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  grantedBy       User?     @relation("AdminGrantor", fields: [grantedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([revokedAt])
  @@map("admin_accounts")
}
