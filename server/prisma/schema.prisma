generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETION_REQUESTED
  DELETED
}

enum DonorAvailabilityStatus {
  AVAILABLE
  PAUSED
}

enum BloodRequestUrgency {
  URGENT
  SCHEDULED
}

enum BloodRequestStatus {
  OPEN
  PAUSED
  CANCELLED
  CLOSED
  EXPIRED
  FULFILLED
}

enum NotificationType {
  DONOR_OPPORTUNITY
  DONOR_ACCEPTED
  DONOR_DECLINED
  DONOR_WITHDREW
  REQUEST_STATUS
  ORGANIZATION_SUBMITTED
  ORGANIZATION_APPROVED
  ORGANIZATION_REJECTED
  ORGANIZATION_SUSPENDED
}

enum OrganizationType {
  HOSPITAL
  BLOOD_BANK
}

enum OrganizationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum OrganizationMembershipRole {
  OWNER
  MANAGER
  STAFF
}

enum OrganizationMembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum OrganizationVerificationAction {
  SUBMITTED
  APPROVED
  REJECTED
  SUSPENDED
}

enum RequestMatchStatus {
  NOTIFIED
  ACCEPTED
  DECLINED
  WITHDRAWN
  INVALIDATED
  CLOSED
}

model User {
  id               String                  @id @default(uuid()) @db.Char(36)
  email            String                  @unique @db.VarChar(254)
  passwordHash     String                  @map("password_hash") @db.VarChar(255)
  fullName         String                  @map("full_name") @db.VarChar(120)
  emailVerifiedAt  DateTime?               @map("email_verified_at") @db.DateTime(3)
  status           UserStatus              @default(PENDING_VERIFICATION)
  createdAt        DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt        DateTime?               @map("deleted_at") @db.DateTime(3)
  sessions         Session[]
  emailTokens      EmailVerificationToken[]
  adminAccount     AdminAccount?
  grantedAdmins   AdminAccount[]          @relation("AdminGrantor")
  donorProfile     DonorProfile?
  bloodRequests    BloodRequest[]
  notifications    Notification[]
  organizationsCreated Organization[] @relation("OrganizationCreator")
  organizationMemberships OrganizationMembership[]
  verificationActions OrganizationVerificationEvent[] @relation("VerificationActor")

  @@index([status, createdAt])
  @@map("users")
}

model BloodGroup {
  id            Int            @id @default(autoincrement()) @db.UnsignedSmallInt
  code          String         @unique @db.VarChar(3)
  displayName   String         @map("display_name") @db.VarChar(30)
  donorProfiles DonorProfile[]
  bloodRequests BloodRequest[]

  @@map("blood_groups")
}

model DonorProfile {
  id                    String                  @id @default(uuid()) @db.Char(36)
  userId                String                  @unique @map("user_id") @db.Char(36)
  displayName           String                  @map("display_name") @db.VarChar(120)
  bloodGroupId          Int                     @map("blood_group_id") @db.UnsignedSmallInt
  division              String                  @db.VarChar(80)
  district              String                  @db.VarChar(80)
  area                  String                  @db.VarChar(100)
  availabilityStatus    DonorAvailabilityStatus @default(PAUSED) @map("availability_status")
  discoveryConsentAt    DateTime?               @map("discovery_consent_at") @db.DateTime(3)
  consentVersion        String?                 @map("consent_version") @db.VarChar(32)
  consentUpdatedAt      DateTime?               @map("consent_updated_at") @db.DateTime(3)
  createdAt             DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.DateTime(3)
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  bloodGroup            BloodGroup              @relation(fields: [bloodGroupId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  requestMatches        RequestMatch[]

  @@index([bloodGroupId, availabilityStatus, discoveryConsentAt], map: "donor_profiles_blood_group_avail_consent_idx")
  @@index([division, district, area])
  @@map("donor_profiles")
}

model BloodRequest {
  id               String              @id @default(uuid()) @db.Char(36)
  requesterUserId  String              @map("requester_user_id") @db.Char(36)
  organizationId   String?             @map("organization_id") @db.Char(36)
  bloodGroupId     Int                 @map("blood_group_id") @db.UnsignedSmallInt
  unitsRequested   Int                 @map("units_requested") @db.UnsignedSmallInt
  division         String              @db.VarChar(80)
  district         String              @db.VarChar(80)
  area             String              @db.VarChar(100)
  urgency          BloodRequestUrgency
  neededAt         DateTime            @map("needed_at") @db.DateTime(3)
  facilityName     String?             @map("facility_name") @db.VarChar(180)
  publicNote       String?             @map("public_note") @db.VarChar(500)
  status           BloodRequestStatus  @default(OPEN)
  closedAt         DateTime?           @map("closed_at") @db.DateTime(3)
  createdAt        DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.DateTime(3)
  requester        User                @relation(fields: [requesterUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  organization     Organization?       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  bloodGroup       BloodGroup          @relation(fields: [bloodGroupId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  matches          RequestMatch[]

  @@index([requesterUserId, createdAt])
  @@index([organizationId, createdAt])
  @@index([status, neededAt, createdAt])
  @@index([bloodGroupId, division, district, area, status])
  @@map("blood_requests")
}

model Notification {
  id            String           @id @default(uuid()) @db.Char(36)
  userId        String           @map("user_id") @db.Char(36)
  eventKey      String           @unique(map: "notifications_event_key_key") @map("event_key") @db.VarChar(191)
  type          NotificationType
  title         String           @db.VarChar(120)
  message       String           @db.VarChar(280)
  referenceType String?          @map("reference_type") @db.VarChar(32)
  referenceId   String?          @map("reference_id") @db.Char(36)
  readAt        DateTime?        @map("read_at") @db.DateTime(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  user          User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model Organization {
  id                    String                    @id @default(uuid()) @db.Char(36)
  name                  String                    @db.VarChar(180)
  type                  OrganizationType
  registrationNumber    String                    @unique(map: "organizations_registration_number_key") @map("registration_number") @db.VarChar(80)
  division              String                    @db.VarChar(80)
  district              String                    @db.VarChar(80)
  area                  String                    @db.VarChar(100)
  publicContactPhone    String                    @map("public_contact_phone") @db.VarChar(32)
  verificationInfo      String?                   @map("verification_info") @db.VarChar(1000)
  status                OrganizationStatus        @default(PENDING)
  createdByUserId       String                    @map("created_by_user_id") @db.Char(36)
  createdAt             DateTime                  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime                  @updatedAt @map("updated_at") @db.DateTime(3)
  creator               User                      @relation("OrganizationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  memberships           OrganizationMembership[]
  verificationHistory   OrganizationVerificationEvent[]
  bloodRequests         BloodRequest[]

  @@index([status, createdAt])
  @@index([createdByUserId, createdAt])
  @@map("organizations")
}

model OrganizationMembership {
  id             String                       @id @default(uuid()) @db.Char(36)
  organizationId String                       @map("organization_id") @db.Char(36)
  userId         String                       @map("user_id") @db.Char(36)
  role           OrganizationMembershipRole  @default(OWNER)
  status         OrganizationMembershipStatus @default(ACTIVE)
  createdAt      DateTime                     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime                     @updatedAt @map("updated_at") @db.DateTime(3)
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user           User                         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([organizationId, userId], map: "organization_memberships_organization_user_key")
  @@index([userId, status])
  @@index([organizationId, status])
  @@map("organization_memberships")
}

model OrganizationVerificationEvent {
  id             String                        @id @default(uuid()) @db.Char(36)
  organizationId String                        @map("organization_id") @db.Char(36)
  actorUserId    String?                       @map("actor_user_id") @db.Char(36)
  action         OrganizationVerificationAction
  fromStatus     OrganizationStatus?           @map("from_status")
  toStatus       OrganizationStatus            @map("to_status")
  reason         String?                       @db.VarChar(500)
  createdAt      DateTime                      @default(now()) @map("created_at") @db.DateTime(3)
  organization   Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor          User?                         @relation("VerificationActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("organization_verification_events")
}

model RequestMatch {
  id                      String            @id @default(uuid()) @db.Char(36)
  requestId               String            @map("request_id") @db.Char(36)
  donorProfileId          String            @map("donor_profile_id") @db.Char(36)
  matchStatus             RequestMatchStatus @default(NOTIFIED) @map("match_status")
  locationRank            Int               @map("location_rank") @db.UnsignedTinyInt
  priorNotificationCount  Int               @map("prior_notification_count") @db.UnsignedInt
  lastPriorNotifiedAt     DateTime?         @map("last_prior_notified_at") @db.DateTime(3)
  rankFactors             Json              @map("rank_factors")
  notifiedAt              DateTime          @map("notified_at") @db.DateTime(3)
  respondedAt             DateTime?         @map("responded_at") @db.DateTime(3)
  createdAt               DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt               DateTime          @updatedAt @map("updated_at") @db.DateTime(3)
  request                 BloodRequest      @relation(fields: [requestId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  donorProfile            DonorProfile      @relation(fields: [donorProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([requestId, donorProfileId], map: "request_matches_request_donor_key")
  @@index([requestId, matchStatus])
  @@index([donorProfileId, matchStatus, createdAt])
  @@index([donorProfileId, notifiedAt])
  @@map("request_matches")
}

model Session {
  id         String    @id @default(uuid()) @db.Char(36)
  userId     String    @map("user_id") @db.Char(36)
  secretHash String    @unique @map("secret_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.DateTime(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  revokedAt  DateTime? @map("revoked_at") @db.DateTime(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  usedAt    DateTime? @map("used_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model AdminAccount {
  userId          String    @id @map("user_id") @db.Char(36)
  grantedByUserId String?   @map("granted_by_user_id") @db.Char(36)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  revokedAt       DateTime? @map("revoked_at") @db.DateTime(3)
  user            User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  grantedBy       User?     @relation("AdminGrantor", fields: [grantedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([revokedAt])
  @@map("admin_accounts")
}
